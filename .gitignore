# iOS
aceTrace_ios/*.xcworkspace
aceTrace_ios/*.xcodeproj/*
!aceTrace_ios/*.xcodeproj/project.pbxproj
aceTrace_ios/DerivedData/
aceTrace_ios/.build/
aceTrace_ios/build/
aceTrace_ios/*.ipa
aceTrace_ios/*.xcarchive

# Node / Scratch / Temp
node_modules/
*.log
scratch/
test_videos/
